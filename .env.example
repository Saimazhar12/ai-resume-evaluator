# Copy this file to .env and fill in your key
GOOGLE_API_KEY=your-gemini-api-key-here

# Model used for analysis (any Gemini model that supports structured output)
GEMINI_MODEL=gemini-3.5-flash-lite

# Flask
FLASK_SECRET_KEY=change-me-in-production
MAX_UPLOAD_MB=8

# Comma-separated list of origins allowed to call the API (the React dev
# server runs on 5173 by default). Add your deployed frontend URL in prod.
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173